{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://looperators.local/schemas/agent-loop/legacy-native-target-evidence-v1.json",
  "title": "looperators Legacy Native Target Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceVersion",
    "runId",
    "stateRevision",
    "historyDigest",
    "entries",
    "evidenceDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "stateRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "historyDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/entry" }
    },
    "evidenceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factKind",
        "factId",
        "factDigest",
        "field",
        "role",
        "bindingId",
        "bindingDigest"
      ],
      "properties": {
        "factKind": { "enum": ["transition", "report"] },
        "factId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "factDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "field": { "enum": ["toNode", "routedToNode"] },
        "role": { "enum": ["implementer", "reviewer"] },
        "bindingId": {
          "type": "string",
          "pattern": "^binding_[a-f0-9]{64}$"
        },
        "bindingDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "factKind": { "const": "transition" }
            },
            "required": ["factKind"]
          },
          "then": {
            "properties": { "field": { "const": "toNode" } }
          },
          "else": {
            "properties": {
              "field": { "const": "routedToNode" }
            }
          }
        }
      ]
    }
  }
}
