{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://looperators.local/schemas/agent-loop/transition-v1.json",
  "title": "looperators Loop Transition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "transitionId",
    "runId",
    "kind",
    "lap",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "transitionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "requestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "kind": {
      "enum": [
        "activate-reviewer",
        "activate-implementer",
        "succeed",
        "pause",
        "resume",
        "cancel",
        "interrupt",
        "cap"
      ]
    },
    "fromNode": { "type": "string", "minLength": 1, "maxLength": 256 },
    "toNode": { "type": "string", "minLength": 1, "maxLength": 256 },
    "originReportId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "originEventId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "lap": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "leaseEpoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "fromRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "toRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "requestId": true },
        "required": ["requestId"]
      },
      "then": {
        "properties": {
          "requestDigest": true,
          "fromRevision": true,
          "toRevision": true
        },
        "required": ["requestDigest", "fromRevision", "toRevision"]
      }
    }
  ]
}
